[
	{
		"type": "group",
		"title": "登录方式",
		"items": [
			{
				"type": "picker",
				"key": "authMode",
				"title": "登录方式",
				"values": [
					"web",
					"token"
				],
				"titles": [
					"网页登录",
					"Token 登录"
				],
				"default": "web",
				"notification": "authChanged",
				"refreshes": [
					"settings",
					"content"
				]
			}
		]
	},
	{
		"type": "group",
		"title": "账号登录",
		"requires": "authMode == web",
		"items": [
			{
				"type": "login",
				"method": "web",
				"key": "webLogin",
				"title": "登录 Pixiv",
				"url": "https://pixiv.net/login.php",
				"logoutTitle": "退出 Pixiv",
				"clearCookiesOnLogOut": true,
				"notification": "webLoginChanged",
				"refreshes": [
					"settings",
					"content"
				]
			}
		]
	},
	{
		"type": "group",
		"title": "账号登录",
		"footer": "Refresh Token 可自动续期；Access Token 到期后需手动更换。粘贴 Token 后点击验证。",
		"items": [
			{
				"type": "picker",
				"key": "tokenKind",
				"title": "Token 类型",
				"values": [
					"refresh",
					"access"
				],
				"titles": [
					"Refresh Token",
					"Access Token"
				],
				"default": "refresh",
				"notification": "tokenChanged",
				"refreshes": [
					"settings",
					"content"
				]
			},
			{
				"type": "text",
				"key": "tokenInput",
				"title": "Token",
				"placeholder": "粘贴所选类型的 Token",
				"secure": true,
				"autocorrectionDisabled": true,
				"autocapitalizationType": 0,
				"notification": "tokenChanged",
				"refreshes": [
					"settings",
					"content"
				]
			},
			{
				"type": "button",
				"key": "validateLogin",
				"title": "验证 Token",
				"notification": "validateLogin",
				"refreshes": [
					"settings",
					"content"
				]
			},
			{
				"type": "button",
				"key": "clearToken",
				"title": "退出 Token 登录",
				"notification": "clearToken",
				"refreshes": [
					"settings",
					"content"
				],
				"confirmTitle": "退出 Token 登录",
				"confirmText": "清除已输入的 Token 和自动续期缓存？",
				"destructive": true
			}
		],
		"requires": "authMode == token"
	},
	{
		"type": "group",
		"title": "阅读设置",
		"footer": "每个作品作为一本书，全部图片作为一章。暂不支持小说和动图。内容可见范围同时受 Pixiv 账号设置限制。",
		"items": [
			{
				"type": "switch",
				"key": "originalImages",
				"title": "加载原图",
				"default": true
			},
			{
				"type": "page",
				"key": "contentFilters",
				"title": "内容过滤",
				"items": [
					{
						"type": "group",
						"items": [
							{
								"type": "switch",
								"key": "showAI",
								"title": "显示 AI 生成作品",
								"default": false,
								"refreshes": [
									"content"
								]
							},
							{
								"type": "switch",
								"key": "showAdult",
								"title": "显示成人向作品",
								"default": false,
								"refreshes": [
									"content"
								]
							}
						]
					}
				]
			}
		]
	}
]
